{
  "name": "apple-productivity-mcp-server",
  "version": "1.1.0",
  "description": "MCP server that gives an LLM access to the macOS Calendar, Notes, Reminders and Mail apps via AppleScript/JXA (osascript).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "apple-productivity-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && shx chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "shx": "^0.3.4",
    "typescript": "^5.5.4"
  }
}
